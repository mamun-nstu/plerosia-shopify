
      
<article class="w-full flex justify-center">
  <div class="max-w-3xl w-full px-4 py-10 text-center">

    {% for block in section.blocks %}
      {% case block.type %}

        {% when "article_title" %}
          <h1 class="text-4xl font-bold mb-4">
            {{ article.title }}
          </h1>

        {% when "article_author" %}
          {% if section.settings.enable_author %}
            <p class="text-lg text-gray-600 mb-2">
              By {{ article.author }}
            </p>
          {% endif %}

        {% when "article_published_date" %}
          {% if section.settings.enable_date %}
            <p class="text-base text-gray-500 mb-6">
              {{ article.published_at | date: '%B %d, %Y' }}
            </p>
          {% endif %}

        {% when "article_image" %}
          {% if section.settings.enable_image and article.image %}
            <div class="flex justify-center mb-8">
              <img
                 width="400px" height="150px"
                src="{{ article.image | img_url: 'large' }}"
                alt="{{ article.title }}"
                loading="lazy"
                class="rounded-lg w-full max-h-64 object-cover"
              >
            </div>
          {% endif %}

        {% when "article_content" %}
          {% if section.settings.enable_content %}
            <div class="prose prose-lg mx-auto text-xl leading-relaxed text-left">
              {{ article.content }}
            </div>
          {% endif %}

      {% endcase %}
    {% endfor %}

  </div>
</article>



{%- if blog.comments_enabled? -%}
  <div class="my-10 text-center">

    {%- if article.comments_count > 0 -%}
      {% for comment in article.comments %}
        <div class="border-b border-gray-200 py-4">
          <p class="text-sm text-gray-600">{{ comment.author }} <span class="ml-10">{{ comment.created_at | date: '%B %d, %Y' }}</span></p>
          <p class="text-base text-gray-800">{{ comment.content }}</p>
        </div>
      {% endfor %}
      {%- else -%}
        <p class="text-gray-500 pt-5 pb-5">No comments yet. Be the first to comment!</p>
    {%- endif -%}

    

    <div id="comment_form" class="mb-8">
      {%- form 'new_comment', article -%}
        <div class="flex-1 mx-auto item-center justify-center max-w-4xl px4">
          <div class="px-1 md:flex mb-3">
            <div class="px-3 md:w-1/2">
              <label for="comment_author" class="font-medium uppercase text-gray-700 mb-2">Name</label>
              <input 
                type="text" 
                name="comment[author]" 
                id="comment_author" 
                placeholder="Your Name" 
                class="w-full md:w-1/2 px-3 py-2 border rounded-md">
            </div>
            <div class="px-3 md:w-1/2">
              <label for="comment_email" class="font-medium uppercase text-gray-700 mb-2">Email</label>
              <input 
                type="email" 
                name="comment[email]" 
                id="comment_email" 
                placeholder="Your Email" 
                class="w-full md:w-1/2 px-3 py-2 border rounded-md">
            </div>
          </div>
        </div>
      {%- endform -%}
    </div>

  </div>
{%- endif -%}




{% schema %}
  {
    "name": "Template Article",
    "settings": [
        {
            "type": "checkbox",
            "id": "enable_author",
            "label": "Enable Author",
            "default": false
        }, 
        {
            "type": "checkbox",
            "id": "enable_date",
            "label": "Enable Date",
            "default": false
        },
        {
            "type": "checkbox",
            "id": "enable_image",
            "label": "Enable Image",
            "default": false
        },
        {
            "type": "checkbox",
            "id": "enable_content",
            "label": "Enable Content",
            "default": false
        },
    ],
    "blocks": [
        {
            "name": "Title",
            "type": "article_title",
            "limit": 1,
        },
        {
            "name": "Author",
            "type": "article_author",
            "limit": 1,
        },
        {
            "name": "Published Date",
            "type": "article_published_date",
            "limit": 1,
        },
        {
            "name": "Thumbnail Image",
            "type": "article_image",
            "limit": 1,
        },
        {
            "name": "Content",
            "type": "article_content",
            "limit": 1,
        },
    ],
  }
{% endschema %}