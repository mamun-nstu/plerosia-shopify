
      
<article class="w-full flex justify-center">
  <div class="max-w-4xl w-full px-4 py-10 text-center">

    {% for block in section.blocks %}
      {% case block.type %}

        {% when "article_title" %}
          <h1 class="text-4xl font-bold mb-4">
            {{ article.title }}
          </h1>

        {% when "article_author" %}
          {% if section.settings.enable_author %}
            <p class="text-lg text-gray-600 mb-2">
              By {{ article.author }}
            </p>
          {% endif %}

        {% when "article_published_date" %}
          {% if section.settings.enable_date %}
            <p class="text-base text-gray-500 mb-6">
              {{ article.published_at | date: '%B %d, %Y' }}
            </p>
          {% endif %}

        {% when "article_image" %}
          {% if section.settings.enable_image and article.image %}
            <div class="flex justify-center mb-8">
              <img
                 width="400px" height="150px"
                src="{{ article.image | img_url: 'large' }}"
                alt="{{ article.title }}"
                loading="lazy"
                class="rounded-lg w-full max-h-64 object-cover"
              >
            </div>
          {% endif %}

        {% when "article_content" %}
          {% if section.settings.enable_content %}
            <div class="prose prose-lg mx-auto text-xl leading-relaxed text-left">
              {{ article.content }}
            </div>
          {% endif %}

      {% endcase %}
    {% endfor %}

  </div>
</article>



{%- if blog.comments_enabled? -%}
  <div class="my-12 flex justify-center">
    <div class="max-w-4xl w-full px-6 py-8 border border-gray-200 rounded-lg bg-gray-50">

      <!-- Existing Comments -->
      {%- if article.comments_count > 0 -%}
        <div class="mb-10">
          {% for comment in article.comments %}
            <div class="border-b border-gray-300 py-4">
              <p class="text-sm text-gray-600 flex justify-between">
                <span>{{ comment.author }}</span>
                <span>{{ comment.created_at | date: '%B %d, %Y' }}</span>
              </p>
              <p class="mt-2 text-gray-800 text-base">
                {{ comment.content }}
              </p>
            </div>
          {% endfor %}
        </div>
      {%- else -%}
        <p class="text-gray-500 text-center mb-10">
          No comments yet. Be the first to comment!
        </p>
      {%- endif -%}

      <!-- Comment Form -->
      <div id="comment_form">
        {%- form 'new_comment', article -%}

          {%- if form.posted_successfully? -%}
            <p class="mb-6 text-green-600 text-center">
              Comment submitted successfully! It will appear after approval.
            </p>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="mb-6 text-red-600 text-sm">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <!-- Name + Email -->
          <div class="flex flex-col md:flex-row gap-6 mb-6">
            <div class="w-full md:w-1/2">
              <label for="comment_author" class="block text-sm uppercase text-gray-600 mb-2">
                Name
              </label>
              <input
                type="text"
                name="comment[author]"
                id="comment_author"
                required
                class="w-full px-4 py-3 border rounded-md text-gray-700 text-sm focus:outline-none focus:ring-2 focus:ring-gray-300"
              >
            </div>

            <div class="w-full md:w-1/2">
              <label for="comment_email" class="block text-sm uppercase text-gray-600 mb-2">
                Email
              </label>
              <input
                type="email"
                name="comment[email]"
                id="comment_email"
                required
                class="w-full px-4 py-3 border rounded-md text-gray-700 text-sm focus:outline-none focus:ring-2 focus:ring-gray-300"
              >
            </div>
          </div>

          <!-- Comment Content (FULL WIDTH) -->
          <div class="mb-8">
            <label for="comment_content" class="block text-sm uppercase text-gray-600 mb-2">
              Comment
            </label>
            <textarea
              name="comment[content]"
              id="comment_content"
              rows="5"
              required
              class="w-full px-4 py-3 border rounded-md text-gray-700 text-sm focus:outline-none focus:ring-2 focus:ring-gray-300"
              placeholder="Type your comment here..."
            ></textarea>
          </div>

          <!-- Submit Button -->
          <div class="text-center">
            <button
              type="submit"
              class="inline-block bg-black text-white px-8 py-3 rounded-md text-sm uppercase tracking-wide hover:bg-gray-800 transition"
            >
              Post Comment
            </button>
          </div>

        {%- endform -%}
      </div>

    </div>
  </div>
{%- endif -%}





{% schema %}
  {
    "name": "Template Article",
    "settings": [
        {
            "type": "checkbox",
            "id": "enable_author",
            "label": "Enable Author",
            "default": false
        }, 
        {
            "type": "checkbox",
            "id": "enable_date",
            "label": "Enable Date",
            "default": false
        },
        {
            "type": "checkbox",
            "id": "enable_image",
            "label": "Enable Image",
            "default": false
        },
        {
            "type": "checkbox",
            "id": "enable_content",
            "label": "Enable Content",
            "default": false
        },
    ],
    "blocks": [
        {
            "name": "Title",
            "type": "article_title",
            "limit": 1,
        },
        {
            "name": "Author",
            "type": "article_author",
            "limit": 1,
        },
        {
            "name": "Published Date",
            "type": "article_published_date",
            "limit": 1,
        },
        {
            "name": "Thumbnail Image",
            "type": "article_image",
            "limit": 1,
        },
        {
            "name": "Content",
            "type": "article_content",
            "limit": 1,
        },
    ],
  }
{% endschema %}