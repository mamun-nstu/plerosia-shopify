<div class=" flex flex-col h-100vh justify-center align-center text-center mt-50">
    <div class="text-5xl font-bold mb-10">{{ section.settings.title }} </div>
    <div class="text-2xl">{{ section.settings.subtext_title }} </div>
    <div>
        <button class="mt-20 ">

            {% assign shop_url = shop.secure_url %}

            {% if section.settings.back_btn_url == blank %}
                {% assign back_btn_url = shop_url %}
            {% else %}
                {% assign back_btn_url = section.settings.back_btn_url %}
            {% endif %}

            <a class="bg-green-600 font-bold  p-5 text-2xl rounded-2xl shadow hover:bg-green-800 text-white" href="{{ back_btn_url }}"> {{ section.settings.back_btn_label }} </a>
        </button>
    </div>
</div>



{% schema %}
  {
    "name": "Template - 404",
    "tag": "section",
    "class": "flex flex-column justify-center align-center",
    "settings": [
        {
            "type": "text",
            "id": "title",
            "label": "404 Page Title",
            "default": "404 Page Not Found"
        },
        {
            "type": "text",
            "id": "subtext_title",
            "label": "404 Page Subtext Title",
            "default": "The page you are looking for does not exist."
        },
        {
            "type": "text",
            "id": "back_btn_label",
            "label": "Button Label",
            "default": "Back to Home"
        },
        {
            "type": "url",
            "id": "back_btn_url",
            "label": "Button Link",
        }
      
    ],
  }
{% endschema %}